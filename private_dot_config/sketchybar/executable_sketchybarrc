#!/bin/bash

# This is a sketchybarrc file that uses Lua scripts instead of Bash scripts

LUA_PLUGIN_DIR="$CONFIG_DIR/lua_plugins"
BASH_PLUGIN_DIR="$CONFIG_DIR/bash_plugins" # necessary for performance (example from demo, ensure this path is correct if you use it)
ITEM_DIR="$CONFIG_DIR/items"

sketchybar --bar position=top height=40 blur_radius=30 color=0x40000000

# Enable media tracking
sketchybar --set media active=yes

default=(
  padding_left=5
  padding_right=5
  icon.font="JetBrainsMono Nerd Font:Propo:17.0"
  label.font="JetBrainsMono Nerd Font:Propo:14.0"
  icon.color=0xffffffff
  label.color=0xffffffff
  icon.padding_left=4
  icon.padding_right=4
  label.padding_left=4
  label.padding_right=4
)

# Define common group style with white outline
group_style=(
  background.color=0x00000000
  background.border_color=0x60ffffff
  background.corner_radius=15
  background.height=30
  background.padding_left=0
  background.padding_right=0
  padding_left=8
  padding_right=8
  drawing=on
)

# Define group style only for music
music_group=("${group_style[@]}")
music_group+=(width=100 padding_left=12)

sketchybar --default "${default[@]}"

source "$ITEM_DIR/aerospace.sh"
source "$ITEM_DIR/front_app.sh"

# Add all items first
source "$ITEM_DIR/clock.sh"
source "$ITEM_DIR/volume.sh"
source "$ITEM_DIR/battery.sh"
sketchybar --add item group_separator_1 right
source "$ITEM_DIR/currently_playing.sh"

# Create brackets to group items with backgrounds
sketchybar --add bracket music_group currently_playing \
           --set music_group "${music_group[@]}"

sketchybar --set group_separator_1 width=10 drawing=on

sketchybar --update
